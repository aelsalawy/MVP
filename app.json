{
  "expo": {
    "name": "CarPulse",
    "slug": "car-tracker-app",
    "scheme": "cartracker",
    "version": "1.0.0",
    "extra": {
      "sentryDsn": "https://f9b6b71cccaaa7b97ef78edfb9c5c549@o4512483542695936.ingest.de.sentry.io/4512483626647632"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cartracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cartracker.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan your vehicle's VIN."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
