# Car Tracker MVP — environment configuration
# Copy to .env.local and fill in real values from the Firebase console.
# These are build-time (EXPO_PUBLIC_*) values only — safe to expose in the client.
# Never put server secrets (service account keys) here; those belong in Cloud Functions.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
