    "expo-router": "~58.0.32",
    "expo-sharing": "^58.0.23",
    "expo-status-bar": "~58.0.5",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
